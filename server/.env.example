# Server Environment Configuration Example
PORT=5000
MONGO_URI=mongodb://localhost:27017/holder_db
NODE_ENV=development
JWT_SECRET=replace_with_at_least_32_random_bytes

# URL Configurations
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5000
# Comma-separated exact browser origins allowed to call the API.
CLIENT_URLS=http://localhost:3000
# Set this to the installed extension's exact chrome-extension:// origin when deployed.
# EXTENSION_ORIGIN=chrome-extension://your_extension_id

# Google OAuth Credentials (Passport.js)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Recommended for production file uploads (images and PDFs); local disk is the fallback.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Optional retrieval-augmented answers through Cloudflare Workers AI.
# The API token needs Account > Workers AI > Read permission.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_workers_ai_token
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_AI_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
# Optional Cloudflare AI Gateway name if you use AI Gateway
# CLOUDFLARE_AI_GATEWAY=your_gateway_name

# Optional alternative Vision HTR provider (Google Gemini Flash Vision)
# GEMINI_API_KEY=your_gemini_api_key_here
